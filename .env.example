# Server-only Supabase credentials. Never expose the service role key in NEXT_PUBLIC_*.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Admin dashboard password/session signing secret. Use a long random secret (32+ bytes).
CELESTIA_ADMIN_PASSWORD=replace-with-strong-admin-password
CELESTIA_SESSION_SECRET=replace-with-a-long-random-secret

# Exact origin(s) of the static shop, comma-separated (scheme + hostname + optional port; no path).
SHOP_ALLOWED_ORIGINS=https://your-shop.example

# Optional: international WhatsApp number, digits only (no + or spaces).
NEXT_PUBLIC_CELESTIA_WHATSAPP_NUMBER=15551234567
